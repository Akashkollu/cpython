from fpdf import FPDF

class PDF(FPDF):
    def header(self):
        self.set_font('Arial', 'B', 15)
        self.cell(0, 10, 'B.Tech Engineering Physics - Exam Notes', 0, 1, 'C')
        self.ln(10)

    def footer(self):
        self.set_y(-15)
        self.set_font('Arial', 'I', 8)
        self.cell(0, 10, f'Page {self.page_no()}', 0, 0, 'C')

    def chapter_title(self, title):
        self.set_font('Arial', 'B', 12)
        self.set_fill_color(200, 220, 255)
        self.cell(0, 10, title, 0, 1, 'L', 1)
        self.ln(4)

    def chapter_body(self, body):
        self.set_font('Arial', '', 11)
        self.multi_cell(0, 7, body)
        self.ln()

# Create PDF object
pdf = PDF()
pdf.add_page()

# Content Data
content = [
    ("UNIT 1: Optics - Newton's Rings", 
     """Aim: To determine the wavelength (lambda) of monochromatic light.
     
Principle: Interference in a thin air film between a plano-convex lens and a glass plate.

Formula for Dark Rings:
2t = n * lambda
Diameter squared: D_n^2 = 4n R lambda

Final Formula for Wavelength:
lambda = (D_(n+m)^2 - D_n^2) / (4mR)
"""),
    
    ("UNIT 2: Crystal Structure - APF", 
     """Atomic Packing Factor (APF) = Volume of Atoms / Volume of Unit Cell.

1. Body-Centered Cubic (BCC):
- Atoms: 2
- Relation: 4r = a * sqrt(3)
- APF: 0.68 (68%)

2. Face-Centered Cubic (FCC):
- Atoms: 4
- Relation: 4r = a * sqrt(2)
- APF: 0.74 (74%)
"""),
    
    ("UNIT 3: Quantum Mechanics - Particle in a Box", 
     """Schrodinger Equation (Time Independent):
d^2(psi)/dx^2 + (2mE/h_bar^2)psi = 0

Boundary Conditions:
psi = 0 at x = 0 and x = L

Energy Eigenvalues (Quantized):
E_n = (n^2 * h^2) / (8mL^2)
"""),
    
    ("UNIT 4: Dielectrics - Clausius-Mossotti Eq", 
     """Relates microscopic polarizability (alpha) to macroscopic dielectric constant (epsilon_r).

Local Field: E_loc = E + P / (3 * epsilon_0)
Polarization: P = N * alpha * E_loc

Final Equation:
(epsilon_r - 1) / (epsilon_r + 2) = (N * alpha) / (3 * epsilon_0)
"""),
    
    ("UNIT 5: Semiconductors - Hall Effect", 
     """Principle: A transverse voltage (Hall Voltage) is created when magnetic field is applied perpendicular to current.

Force Balance:
Electric Force = Magnetic Force
e * E_H = e * v_d * B

Hall Coefficient (R_H):
R_H = 1 / (n * e)

Hall Voltage (V_H):
V_H = (I * B) / (n * e * d)
""")
]

# Write Content
for title, body in content:
    pdf.chapter_title(title)
    pdf.chapter_body(body)

# Save the file
# If running locally, this saves to your current folder.
# If running in Google Colab, look in the 'Files' tab on the left.
pdf.output("Engineering_Physics_Notes.pdf")

print("PDF generated successfully: 'Engineering_Physics_Notes.pdf'")
